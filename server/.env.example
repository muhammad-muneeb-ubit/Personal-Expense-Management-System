PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=expense_manager
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
APP_NAME=Pocketwise
# Optional SMTP settings. Without these, verification/reset links are printed in the API terminal in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pocketwise <no-reply@example.com>
